# Copy to .env for docker compose, or pass with `docker run --env-file`.

# Which torch build to install -- match the host driver (see DOCKER.md).
CUDA_EXTRA=cu130

# Host paths mounted into the container.
DATA_DIR=../data
OUT_DIR=./out

# AiRouterV2 credentials, only needed for --label-method llm --label-llm-backend air2.
AIR2_BASE_URL=https://airouter-v2.questionpro.com/cs/api/air2
AIR2_QP_OAUTH_HOST=
AIR2_S2S_CLIENT_ID=
AIR2_S2S_CLIENT_SECRET=
AIR2_CONSUMER_ID=
AIR2_USER_ID=

# AI Router v1: LLM labels (--label-method llm) AND, in this copy, the stream
# matcher's per-record decisions (--decision-backend gpt, the default).
# Put the real key in .env only -- never in this file, which is committed.
api_key=
use_case=reputation-topic-generation
base_url=https://airouter-api.questionpro.com
# AIROUTER_MODEL=gpt-4.1-mini-chat-completion

# Laya decision model -- only for --decision-backend laya. From inside the
# container a laya-serve on this machine is http://host.docker.internal:8000.
LAYA_BASE_URL=
# LAYA_API_KEY=            # only when laya-serve was started with LAYA_API_KEY
# LAYA_MODEL=multilingual  # pin a checkpoint; default lets the server route per post
# LAYA_TIMEOUT=60
